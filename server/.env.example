# Copy to .env and fill in. Never commit the real .env.

# HTTP port the server listens on.
PORT=8080

# PostgreSQL connection string.
# Local docker-compose default:
DATABASE_URL=postgres://encrypted:encrypted@localhost:5432/encrypted

# Secret used to sign auth tokens. Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# --- Purchase verification (optional until you have real purchases) ---------
# If these are left blank the server runs in DEV purchase mode: it trusts the
# client and logs a warning. Set them before taking real payments.

# Your Android applicationId (must match app.config.ts android.package).
ANDROID_PACKAGE=com.yourcompany.encrypted

# Google Play service-account key JSON. Either the raw JSON on one line, or a
# path to the file. Create it in Google Cloud and grant it access in Play
# Console -> Users and permissions.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Apple App Store shared secret (App Store Connect -> App Information ->
# App-Specific Shared Secret) for receipt validation.
APPLE_SHARED_SECRET=

# --- Social layer + owner revenue -------------------------------------------
# Usernames granted owner/admin access (comma or space separated). These
# accounts can open the in-app Revenue dashboard and place sponsored posts.
ADMIN_USERNAMES=

# Platform's cut of each creator tip, as a percentage (0–100). Default 20.
PLATFORM_CUT_PERCENT=20

# Estimated effective CPM (cents per 1000 ad impressions) used only for the
# in-app ad-revenue estimate. Real payouts are reported by AdMob. Default 300.
AD_ECPM_CENTS=300

# --- Media uploads ----------------------------------------------------------
# Directory where uploaded photos/videos are written (default <server>/uploads).
# On ephemeral hosts this does not survive redeploys — use object storage (S3/
# Cloudinary/R2) in production; see docs/SOCIAL.md.
UPLOADS_DIR=
# Public base URL of this server, used to build absolute media URLs. Leave
# blank to derive it from the request host; set it when behind a proxy/CDN.
PUBLIC_URL=
