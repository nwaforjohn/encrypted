# ============================================================================
#  AuroraVPN backend configuration. Copy to `.env` and fill in.
# ============================================================================

# --- Core ---
PORT=8080
# Long random string. Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated list of origins allowed to call the API (your website + admin).
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# --- Database ---
# Postgres connection string. docker-compose sets this automatically.
DATABASE_URL=postgres://aurora:aurora@localhost:5432/aurora

# --- Admin bootstrap ---
# The account registered with this email is automatically given the 'admin'
# role (so it can see the revenue dashboard). Set it to YOUR email.
ADMIN_EMAIL=you@example.com

# --- Stripe (website subscriptions) ---
# From https://dashboard.stripe.com/apikeys  (use test keys while building)
STRIPE_SECRET_KEY=sk_test_xxx
# From the webhook endpoint you create in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Price IDs you create in Stripe (Products -> add price -> recurring).
STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_YEARLY=price_xxx
# Where Stripe Checkout returns the user after pay / cancel.
CHECKOUT_SUCCESS_URL=http://localhost:5173/account.html?checkout=success
CHECKOUT_CANCEL_URL=http://localhost:5173/pricing.html?checkout=cancel

# --- Mobile in-app purchases (optional, fill when you set up IAP) ---
# Apple App Store shared secret (App Store Connect -> App -> In-App Purchases).
APPLE_SHARED_SECRET=
# Google Play service-account JSON path (for Play Developer API verification).
GOOGLE_SERVICE_ACCOUNT_JSON=
# Your Android package name, e.g. net.auroravpn.app
GOOGLE_PACKAGE_NAME=

# --- Tunnel defaults handed to clients ---
# DNS the tunnel pushes to the device (1.1.1.1 = Cloudflare). Blocks DNS leaks.
TUNNEL_DNS=1.1.1.1
# MTU for the WireGuard interface on the client.
TUNNEL_MTU=1420
